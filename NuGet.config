<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    内部 Nexus 优先（内网约 1.4 MB/s），nuget.org 兜底。
    nuget-group 是 nuget.org 的代理，所以离线/外网环境下删掉这一段也能还原。
    内部源是 HTTP，NuGet 6.8+ 要求显式声明 allowInsecureConnections。
  -->
  <packageSources>
    <clear />
    <add key="lux-nexus"
         value="http://10.32.36.101:8081/repository/nuget-group/index.json"
         allowInsecureConnections="true" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
