<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>awrtool</AssemblyName>
    <RootNamespace>AwrTool</RootNamespace>
    <Version>0.1.0</Version>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>

    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Oracle 的 NLS / 字符集转换需要正常文化信息，不能开 InvariantGlobalization -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    发布形态：单文件 + 自包含。目标机器不需要装 .NET 运行时。
      单文件   —— 一个可执行文件，方便给 AI 工具挂载
      自包含   —— 不依赖目标机器的 .NET 框架

    刻意不开 PublishReadyToRun：实测单文件下它是净亏。
    同一份代码，win-x64 实测（各 6 次取样中位数）：
      开 R2R  —— 93 MB，启动 142 ms
      关 R2R  —— 72 MB，启动 130 ms
    原因是单文件形态的启动开销主要在程序集加载而不是 JIT，R2R 反而把镜像撑大。
    仅在显式指定 RID 时生效，保证日常 `dotnet build` / `dotnet test` 不受影响。
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- ODP.NET 附带一个原生 DLL，必须一起打进单文件 -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.0" />
  </ItemGroup>

</Project>
